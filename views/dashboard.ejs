<h1 class="text-3xl font-bold text-gray-800 mb-6">Dashboard</h1>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white p-6 rounded-xl shadow-md flex items-center transition-transform hover:scale-105">
        <div class="bg-green-100 p-4 rounded-lg text-green-600 mr-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 10v-1m0 0a2.5 2.5 0 100-5 2.5 2.5 0 000 5z"></path></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500"><%= revenueSource %></p>
            <p class="text-2xl font-bold text-gray-800">Rp <%= revenue.toLocaleString('id-ID') %></p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-md flex items-center transition-transform hover:scale-105">
        <div class="bg-blue-100 p-4 rounded-lg text-blue-600 mr-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500">Total Users</p>
            <p class="text-2xl font-bold text-gray-800"><%= totalUsers %></p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-md flex items-center transition-transform hover:scale-105">
        <div class="bg-yellow-100 p-4 rounded-lg text-yellow-600 mr-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500">Total Stock</p>
            <p class="text-2xl font-bold text-gray-800"><%= totalStock %></p>
        </div>
    </div>
    <div class="bg-white p-6 rounded-xl shadow-md flex items-center transition-transform hover:scale-105">
        <div class="bg-indigo-100 p-4 rounded-lg text-indigo-600 mr-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        </div>
        <div>
            <p class="text-sm text-gray-500">Successful Orders</p>
            <p class="text-2xl font-bold text-gray-800"><%= paidOrdersCount %></p>
        </div>
    </div>
</div>
<div class="mt-8 bg-white p-6 rounded-xl shadow-md">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Recent Transactions</h2>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="text-sm text-gray-500 uppercase border-b-2">
                    <th class="px-4 py-3 font-medium">User</th>
                    <th class="px-4 py-3 font-medium">Product</th>
                    <th class="px-4 py-3 font-medium">Amount</th>
                    <th class="px-4 py-3 font-medium">Date</th>
                    <th class="px-4 py-3 font-medium">Status</th>
                </tr>
            </thead>
            <tbody class="text-gray-700">
                <% recentTransactions.forEach(order => { %>
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-4 py-4">@<%= order.customerInfo.first_name %></td>
                        <td class="px-4 py-4"><%= order.productName %> - <%= order.variantName %></td>
                        <td class="px-4 py-4 font-semibold">Rp <%= order.amount.toLocaleString('id-ID') %></td>
                        <td class="px-4 py-4"><%= new Date(order.paidAt).toLocaleString('id-ID') %></td>
                        <td class="px-4 py-4"><span class="bg-green-100 text-green-800 text-xs font-medium px-2.5 py-1 rounded-full">PAID</span></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>