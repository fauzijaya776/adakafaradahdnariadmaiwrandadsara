<h1 class="text-3xl font-bold text-gray-800 mb-6">Dokumentasi API Stok</h1>
<p class="mb-8 text-gray-600">Gunakan endpoint di bawah ini untuk mengelola stok produk secara terprogram.</p>

<div class="bg-white p-6 rounded-xl shadow-md mb-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">Mengambil Stok</h2>
    
    <div class="mb-4">
        <p class="font-semibold">Endpoint:</p>
        <code class="text-sm bg-gray-100 text-red-600 p-2 rounded-md block">POST /api/take-stock</code>
    </div>

    <p class="mb-4 text-gray-700">API ini digunakan untuk mengambil sejumlah item stok dari varian produk tertentu. Stok akan diambil dari urutan paling atas (FIFO).</p>
    
    <h3 class="text-lg font-semibold text-gray-700 mt-6 mb-3">Parameter Body (JSON)</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead class="bg-gray-50 text-xs text-gray-700 uppercase">
                <tr>
                    <th class="px-4 py-2">Parameter</th>
                    <th class="px-4 py-2">Tipe</th>
                    <th class="px-4 py-2">Deskripsi</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b"><td class="px-4 py-2 font-mono">productId</td><td class="px-4 py-2">String</td><td class="px-4 py-2">ID unik produk.</td></tr>
                <tr class="border-b"><td class="px-4 py-2 font-mono">variantSlug</td><td class="px-4 py-2">String</td><td class="px-4 py-2">Slug unik dari varian.</td></tr>
                <tr class="border-b"><td class="px-4 py-2 font-mono">count</td><td class="px-4 py-2">Integer</td><td class="px-4 py-2">Jumlah stok yang ingin diambil.</td></tr>
            </tbody>
        </table>
    </div>

    <h3 class="text-lg font-semibold text-gray-700 mt-6 mb-3">Contoh Penggunaan (Node.js/Axios)</h3>
    <div class="bg-gray-800 text-white p-4 rounded-lg">
        <pre><code class="language-javascript">const axios = require('axios');

async function takeStock() {
  try {
    const response = await axios.post(
      'http://localhost:4000/api/take-stock',
      {
        productId: 'apelku',
        variantSlug: 'cc6b',
        count: 2
      }
    );
    console.log('Response:', response.data);
  } catch (error) {
    console.error('Error:', error.response.data);
  }
}

takeStock();</code></pre>
    </div>
</div>

<div class="bg-white p-6 rounded-xl shadow-md">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">Mengembalikan Stok</h2>
    
    <div class="mb-4">
        <p class="font-semibold">Endpoint:</p>
        <code class="text-sm bg-gray-100 text-green-600 p-2 rounded-md block">POST /api/return-stock</code>
    </div>

    <p class="mb-4 text-gray-700">API ini digunakan untuk mengembalikan satu atau lebih item stok ke varian produk tertentu. Stok akan ditambahkan kembali ke urutan paling atas.</p>
    
    <h3 class="text-lg font-semibold text-gray-700 mt-6 mb-3">Parameter Body (JSON)</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead class="bg-gray-50 text-xs text-gray-700 uppercase">
                <tr>
                    <th class="px-4 py-2">Parameter</th>
                    <th class="px-4 py-2">Tipe</th>
                    <th class="px-4 py-2">Deskripsi</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b"><td class="px-4 py-2 font-mono">productId</td><td class="px-4 py-2">String</td><td class="px-4 py-2">ID unik produk.</td></tr>
                <tr class="border-b"><td class="px-4 py-2 font-mono">variantSlug</td><td class="px-4 py-2">String</td><td class="px-4 py-2">Slug unik dari varian.</td></tr>
                <tr class="border-b"><td class="px-4 py-2 font-mono">stockItems</td><td class="px-4 py-2">Array of Strings</td><td class="px-4 py-2">Array berisi item stok yang akan dikembalikan.</td></tr>
            </tbody>
        </table>
    </div>

    <h3 class="text-lg font-semibold text-gray-700 mt-6 mb-3">Contoh Penggunaan (Node.js/Axios)</h3>
    <div class="bg-gray-800 text-white p-4 rounded-lg">
        <pre><code class="language-javascript">const axios = require('axios');

async function returnStock() {
  try {
    const response = await axios.post(
      'http://localhost:4000/api/return-stock',
      {
        productId: 'apelku',
        variantSlug: 'cc6b',
        stockItems: [
          'akun_gagal1@email.com|pass123',
          'akun_gagal2@email.com|pass456'
        ]
      }
    );
    console.log('Response:', response.data);
  } catch (error) {
    console.error('Error:', error.response.data);
  }
}

returnStock();</code></pre>
    </div>
</div>