<h1 class="text-3xl font-bold text-gray-800 mb-6">Users</h1><div class="bg-white p-6 rounded-xl shadow-md"><div class="overflow-x-auto"><table class="w-full text-left"><thead><tr class="text-sm text-gray-500 uppercase border-b-2"><th class="px-4 py-3 font-medium">User ID</th><th class="px-4 py-3 font-medium">Username</th><th class="px-4 py-3 font-medium">Total Spent</th></tr></thead><tbody class="text-gray-700"><% users.forEach(user => { %><tr class="border-b hover:bg-gray-50"><td class="px-4 py-4"><%= user.id %></td><td class="px-4 py-4 font-semibold text-indigo-600">@<%= user.username %></td><td class="px-4 py-4 font-semibold">Rp <%= (user.totalSpent || 0).toLocaleString('id-ID') %></td></tr><% }) %></tbody></table></div></div>