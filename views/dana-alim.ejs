<div class="max-w-4xl">
    <% if (resetCount !== null && resetCount > 0) { %>
        <div class="mb-6 text-sm rounded-lg px-4 py-3 bg-green-50 text-green-700 border border-green-100">
            Berhasil di-reset: <b><%= resetCount %></b> catatan senilai
            <b>Rp <%= Number(resetTotal || 0).toLocaleString('id-ID') %></b> ditandai sudah dibayarkan.
        </div>
    <% } else if (resetCount === 0) { %>
        <div class="mb-6 text-sm rounded-lg px-4 py-3 bg-gray-50 text-gray-600 border border-gray-100">
            Tidak ada catatan yang di-reset (sudah 0 atau sudah di-reset sebelumnya).
        </div>
    <% } %>
    <% if (syncNotice && syncNotice.error) { %>
        <div class="mb-6 text-sm rounded-lg px-4 py-3 bg-red-50 text-red-700 border border-red-100">
            Sinkronisasi gagal. Lihat detail di kotak "Sinkronisasi data Alim" di bawah.
        </div>
    <% } else if (syncNotice) { %>
        <div class="mb-6 text-sm rounded-lg px-4 py-3 <%= syncNotice.count > 0 ? 'bg-green-50 text-green-700 border-green-100' : 'bg-gray-50 text-gray-600 border-gray-100' %> border">
            <% if (syncNotice.count > 0) { %>
                Sinkronisasi selesai: <b><%= syncNotice.count %></b> order baru dicatat senilai
                <b>Rp <%= Number(syncNotice.amount || 0).toLocaleString('id-ID') %></b>.
            <% } else { %>
                Sinkronisasi selesai: tidak ada order baru (semua order Alim yang lunas sudah tercatat).
            <% } %>
        </div>
    <% } %>

    <div class="bg-white rounded-xl shadow p-6 mb-6">
        <h2 class="text-lg font-bold text-gray-800 mb-1">Dana tokotelealim (Alim Store)</h2>
        <p class="text-sm text-gray-500 mb-5">
            Gabungan penjualan Alim Store yang sudah dibayar dan masuk ke akun Pakasir bersama:
            bot Telegram (ID <code class="text-xs bg-gray-100 px-1 rounded">ALIM-</code>) dan website
            (ID <code class="text-xs bg-gray-100 px-1 rounded">WEBALIM-</code>). Dipakai untuk tahu berapa yang harus
            dibayarkan saat pencairan. Hanya catatan — tidak memengaruhi saldo Pakasir.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
            <div class="rounded-lg border border-purple-100 bg-purple-50 p-5">
                <div class="text-xs text-purple-700 mb-1">Total belum dibayarkan</div>
                <div class="text-3xl font-bold text-purple-800">Rp <%= Number(total).toLocaleString('id-ID') %></div>
            </div>
            <div class="rounded-lg border border-gray-100 p-5">
                <div class="text-xs text-gray-500 mb-1">Jumlah order tercatat</div>
                <div class="text-3xl font-bold text-gray-800"><%= count %></div>
            </div>
            <div class="rounded-lg border border-sky-100 bg-sky-50 p-4">
                <div class="text-xs text-sky-700 mb-1">📱 Dari bot Telegram (ALIM-)</div>
                <div class="text-xl font-bold text-sky-900">Rp <%= Number(bySrc.tele.total).toLocaleString('id-ID') %></div>
                <div class="text-xs text-sky-700"><%= bySrc.tele.count %> order</div>
            </div>
            <div class="rounded-lg border border-amber-100 bg-amber-50 p-4">
                <div class="text-xs text-amber-700 mb-1">🌐 Dari website (WEBALIM-)</div>
                <div class="text-xl font-bold text-amber-900">Rp <%= Number(bySrc.web.total).toLocaleString('id-ID') %></div>
                <div class="text-xs text-amber-700"><%= bySrc.web.count %> order</div>
            </div>
        </div>

        <form method="POST" action="/dana-alim/reset"
              onsubmit="return confirm('Reset catatan ke Rp 0?\n\nTotal Rp <%= Number(total).toLocaleString('id-ID') %> (<%= count %> order) akan ditandai SUDAH DIBAYARKAN. Data tetap tersimpan di riwayat.');">
            <input type="hidden" name="upto" value="<%= upto %>">
            <button type="submit" <%= count === 0 ? 'disabled' : '' %>
                class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2.5 px-5 rounded-lg text-sm disabled:opacity-50 disabled:cursor-not-allowed">
                Reset ke 0 (sudah dibayarkan)
            </button>
        </form>
    </div>

    <div class="bg-white rounded-xl shadow p-6 mb-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Sinkronisasi data Alim</h3>
        <% if (!sync.enabled) { %>
            <div class="text-sm rounded-lg px-4 py-3 bg-yellow-50 text-yellow-800 border border-yellow-100 mb-3">
                <b>Nonaktif</b> (<code class="text-xs bg-yellow-100 px-1 rounded">ALIM_FEED_URL=off</code>). Dana Alim hanya terisi dari webhook Pakasir;
                kalau webhook tidak sampai, order Alim tidak tercatat walaupun di dashboard Pakasir sudah <i>completed</i>.
            </div>
        <% } else { %>
            <p class="text-sm text-gray-500 mb-3">
                Tiap 3 menit bot membaca order Alim yang sudah lunas (<%= sync.days %> hari terakhir) dari <b><%= sync.sourceLabel %></b>,
                mengecek ulang ke Pakasir, lalu mencatat yang belum tercatat. Tidak bergantung pada webhook.
            </p>
            <% if (sync.last) { %>
                <% if (!sync.last.ok) { %>
                    <div class="text-sm rounded-lg px-4 py-3 bg-red-50 text-red-700 border border-red-100 mb-3">
                        Sinkron terakhir (<%= sync.last.when %>) gagal: <span class="font-mono text-xs"><%= sync.last.error %></span>
                    </div>
                <% } else { %>
                    <p class="text-sm text-gray-600 mb-2">
                        Sinkron terakhir: <b><%= sync.last.when %></b> WIB — <%= sync.last.scanned %> order lunas dibaca,
                        <b><%= sync.last.recorded %></b> baru dicatat<% if (sync.last.pending) { %>, <%= sync.last.pending %> masih pending di Pakasir<% } %><% if (sync.last.failed) { %>, <%= sync.last.failed %> gagal dicek (dicoba lagi)<% } %><% if (sync.last.deferred) { %>, <%= sync.last.deferred %> menunggu putaran berikut<% } %>.
                    </p>
                    <% if (sync.last.noTxn.length) { %>
                        <p class="text-xs text-amber-700 mb-1">Tidak bisa diverifikasi (tanpa txn_id Pakasir): <span class="font-mono"><%= sync.last.noTxn.slice(0, 10).join(', ') %></span></p>
                    <% } %>
                    <% if (sync.last.rejected.length) { %>
                        <p class="text-xs text-gray-500 mb-1">Ditolak saat cek Pakasir: <span class="font-mono"><%= sync.last.rejected.slice(0, 10).join(', ') %></span></p>
                    <% } %>
                <% } %>
            <% } else { %>
                <p class="text-sm text-gray-400 mb-2">Belum pernah sinkron sejak bot menyala.</p>
            <% } %>
            <form method="POST" action="/dana-alim/sync" class="mt-3">
                <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-lg text-sm">Sinkronkan sekarang</button>
            </form>
        <% } %>
        <div class="text-xs text-gray-500 mt-4 border-t pt-3">
            Webhook Pakasir terakhir diterima: <b><%= sync.webhookOk || 'belum pernah tercatat' %></b><% if (sync.webhookOk) { %> WIB<% } %>
            <% if (sync.webhookRejected) { %>
                <br><span class="<%= sync.webhookRejectedNewer ? 'text-red-600' : '' %>">Webhook ditolak (X-Secret tidak cocok) terakhir: <b><%= sync.webhookRejected %></b> WIB<% if (sync.webhookRejectedNewer) { %> — samakan <code>PAKASIR_WEBHOOK_SECRET</code> di Render dengan Secret di detail project Pakasir.<% } %></span>
            <% } %>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow p-6 mb-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-3">Lacak ID pesanan</h3>
        <form method="GET" action="/dana-alim" class="flex flex-wrap gap-2 mb-2">
            <input type="text" name="q" value="<%= q %>" maxlength="64" autocomplete="off"
                   placeholder="WEBALIM-K7Q2M9XA4D atau ALIM-123456789-1759300000000"
                   class="flex-1 min-w-[220px] border border-gray-300 rounded-lg px-3 py-2 text-sm font-mono">
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-lg text-sm">Lacak</button>
            <% if (q) { %><a href="/dana-alim" class="py-2 px-3 text-sm text-gray-500 hover:text-gray-700">Hapus</a><% } %>
        </form>
        <p class="text-xs text-gray-400 mb-3">Boleh sebagian ID. Mencari di semua catatan, termasuk yang sudah dibayarkan.</p>
        <% if (found !== null) { %>
            <% if (found.length === 0) { %>
                <div class="text-sm rounded-lg px-4 py-3 bg-yellow-50 text-yellow-800 border border-yellow-100">
                    ID <b class="font-mono"><%= q %></b> tidak ada di catatan Dana Alim.
                    <% if (lookup && lookup.found) { %>
                        <br>Di database Alim: status <b><%= lookup.alimStatus || '-' %></b>.
                        <% if (lookup.reason) { %>Hasil cek Pakasir: <%= lookup.reason %>.<% } %>
                    <% } else if (lookup) { %>
                        <br>ID ini juga tidak ditemukan di database Alim<% if (lookup.reason) { %> (<%= lookup.reason %>)<% } %>. Pastikan ID tidak salah ketik.
                    <% } else { %>
                        Kemungkinan pesanan belum dibayar / dibatalkan, notifikasi Pakasir belum masuk, atau ID salah ketik.
                    <% } %>
                </div>
            <% } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-gray-500 border-b">
                                <th class="py-2 pr-4 font-medium">ID Order</th>
                                <th class="py-2 pr-4 font-medium">Sumber</th>
                                <th class="py-2 pr-4 font-medium">Dibayar (WIB)</th>
                                <th class="py-2 pr-4 font-medium">Status</th>
                                <th class="py-2 font-medium text-right">Nominal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% found.forEach(function (it) { %>
                                <tr class="border-b last:border-0 align-top">
                                    <td class="py-2 pr-4 font-mono text-xs text-gray-700"><%= it.orderId %>
                                        <% if (it.txnId) { %><div class="text-gray-400">txn <%= it.txnId %></div><% } %></td>
                                    <td class="py-2 pr-4 text-gray-600 whitespace-nowrap"><%= it.source === 'web' ? '🌐 Website' : '📱 Telegram' %>
                                        <% if (it.buyer) { %><div class="text-xs text-gray-400">ID TG <%= it.buyer %></div><% } %></td>
                                    <td class="py-2 pr-4 text-gray-600 whitespace-nowrap"><%= it.when %></td>
                                    <td class="py-2 pr-4 whitespace-nowrap"><% if (it.settled) { %><span class="text-green-700">✅ Sudah dibayarkan</span><div class="text-xs text-gray-400">reset <%= it.settledAt %></div><% } else { %><span class="text-amber-700">⏳ Belum dibayarkan</span><% } %></td>
                                    <td class="py-2 text-right text-gray-800">Rp <%= Number(it.amount).toLocaleString('id-ID') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        <% } %>
    </div>

    <div class="bg-white rounded-xl shadow p-6 mb-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Order belum dibayarkan<% if (count > items.length) { %> (100 terbaru dari <%= count %>)<% } %></h3>
        <% if (items.length === 0) { %>
            <p class="text-sm text-gray-400">Belum ada catatan.</p>
        <% } else { %>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-gray-500 border-b">
                            <th class="py-2 pr-4 font-medium">Waktu (WIB)</th>
                            <th class="py-2 pr-4 font-medium">ID Order</th>
                            <th class="py-2 pr-4 font-medium">Sumber</th>
                            <th class="py-2 font-medium text-right">Nominal</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% items.forEach(function (it) { %>
                            <tr class="border-b last:border-0">
                                <td class="py-2 pr-4 text-gray-600 whitespace-nowrap"><%= it.when %></td>
                                <td class="py-2 pr-4 font-mono text-xs text-gray-700"><a class="hover:underline" href="/dana-alim?q=<%= encodeURIComponent(it.orderId) %>"><%= it.orderId %></a></td>
                                <td class="py-2 pr-4 text-gray-600 whitespace-nowrap"><%= it.source === 'web' ? '🌐 Website' : '📱 Telegram' %></td>
                                <td class="py-2 text-right text-gray-800">Rp <%= Number(it.amount).toLocaleString('id-ID') %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <div class="bg-white rounded-xl shadow p-6">
        <h3 class="text-sm font-semibold text-gray-700 mb-4">Riwayat reset (10 terakhir)</h3>
        <% if (history.length === 0) { %>
            <p class="text-sm text-gray-400">Belum pernah di-reset.</p>
        <% } else { %>
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-gray-500 border-b">
                        <th class="py-2 pr-4 font-medium">Di-reset pada (WIB)</th>
                        <th class="py-2 pr-4 font-medium">Jumlah order</th>
                        <th class="py-2 font-medium text-right">Total dibayarkan</th>
                    </tr>
                </thead>
                <tbody>
                    <% history.forEach(function (h) { %>
                        <tr class="border-b last:border-0">
                            <td class="py-2 pr-4 text-gray-600"><%= h.when %></td>
                            <td class="py-2 pr-4 text-gray-600"><%= h.count %></td>
                            <td class="py-2 text-right text-gray-800">Rp <%= Number(h.total).toLocaleString('id-ID') %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } %>
    </div>
</div>
