<div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-800">Products Management</h1>
    <button onclick="openModal('addProductModal')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg shadow-md transition-transform hover:scale-105">Create Product</button>
</div>

<% if (locals.error) { %>
    <div class="bg-red-100 border-l-4 border-red-500 text-red-700 px-4 py-3 rounded mb-4">
        <p><%= error %></p>
    </div>
<% } %>

<div class="bg-white p-6 rounded-xl shadow-md">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="text-sm text-gray-500 uppercase border-b-2">
                    <th class="px-4 py-3 font-medium">Product ID</th>
                    <th class="px-4 py-3 font-medium">Product</th>
                    <th class="px-4 py-3 font-medium">Description</th>
                    <th class="px-4 py-3 font-medium">Total Stock</th>
                    <th class="px-4 py-3 font-medium">Variants</th>
                    <th class="px-4 py-3 font-medium">Actions</th>
                </tr>
            </thead>
            <tbody class="text-gray-700">
                <% products.forEach(product => { %>
                    <tr class="border-b hover:bg-gray-50">
                        <td class="px-4 py-4 text-sm text-gray-500 font-mono"><%= product.id %></td>
                        <td class="px-4 py-4 font-semibold text-gray-800"><%= product.name %></td>
                        <td class="px-4 py-4 text-sm text-gray-600"><%= product.description %></td>
                        <td class="px-4 py-4 font-medium"><%= product.totalStock %></td>
                        <td class="px-4 py-4 font-medium"><%= product.variants.length %></td>
                        <td class="px-4 py-4">
                            <div class="flex items-center space-x-2">
                                <a href="/products/manage/<%= product.id %>" class="bg-indigo-500 hover:bg-indigo-600 text-white text-sm font-bold py-2 px-4 rounded-lg transition-transform hover:scale-105">Manage</a>

                                <a href="/products/delete/<%= product.id %>" onclick="return confirm('Anda yakin ingin menghapus produk ini? Semua varian dan stoknya akan hilang permanen.')" class="bg-red-500 hover:bg-red-600 text-white text-sm font-bold py-2 px-4 rounded-lg transition-transform hover:scale-105">Delete</a>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<div id="addProductModal" class="fixed z-50 inset-0 overflow-y-auto hidden">
    <div class="flex items-center justify-center min-h-screen">
        <div class="fixed inset-0 bg-black opacity-50" onclick="closeModal('addProductModal')"></div>
        <div class="bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:max-w-lg sm:w-full">
            <form action="/products/add" method="POST">
                <div class="bg-white px-6 py-4">
                    <h3 class="text-lg font-medium text-gray-900 mb-4">Create New Product</h3>
                    <div class="mb-4">
                        <label class="block text-sm">Product ID</label>
                        <input type="text" name="id" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm">Product Name</label>
                        <input type="text" name="name" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required>
                    </div>
                    <div>
                        <label class="block text-sm">Description</label>
                        <textarea name="description" rows="3" class="mt-1 block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500" required></textarea>
                    </div>
                </div>
                <div class="bg-gray-50 px-6 py-3 sm:flex sm:flex-row-reverse">
                    <button type="submit" class="w-full sm:w-auto inline-flex justify-center rounded-md border shadow-sm px-4 py-2 bg-blue-600 text-white hover:bg-blue-700">Save</button>
                    <button type="button" onclick="closeModal('addProductModal')" class="mt-3 w-full sm:mt-0 sm:w-auto inline-flex justify-center rounded-md border-gray-300 shadow-sm px-4 py-2 bg-white text-gray-700 hover:bg-gray-50 sm:ml-3">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openModal(id) {
        const modal = document.getElementById(id);
        modal.classList.remove('hidden');
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        modal.classList.add('hidden');
    }
</script>